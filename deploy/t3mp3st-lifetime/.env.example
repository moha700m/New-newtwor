T3MP3ST_STATE_DIR=/tmp/t3mp3st-state
T3MP3ST_CONFIG_DIR=/tmp/t3mp3st-config
T3MP3ST_MODE=t3mp3st
NODE_ENV=production
# BLOB_READ_WRITE_TOKEN is injected by Vercel Storage. Never commit its value.
TEMPEST_DEFAULT_PROVIDER=openai
T3MP3ST_OPENAI_MODEL=gpt-6.1-sol
# OPENAI_API_KEY is a Vercel Sensitive production secret. Never commit its value.
