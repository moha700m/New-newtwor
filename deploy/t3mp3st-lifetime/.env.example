T3MP3ST_STATE_DIR=/tmp/t3mp3st-state
T3MP3ST_CONFIG_DIR=/tmp/t3mp3st-config
T3MP3ST_MODE=t3mp3st
NODE_ENV=production
T3MP3ST_HOSTED=true
# BLOB_READ_WRITE_TOKEN is injected by Vercel Storage. Never commit its value.
TEMPEST_DEFAULT_PROVIDER=openai
T3MP3ST_OPENAI_MODEL=gpt-6.1-sol
# OPENAI_API_KEY is a Vercel Sensitive production secret. Never commit its value.
# Set a strictly increasing nonsecret writer epoch for every ownership transfer.
T3MP3ST_WRITER_EPOCH=1
T3MP3ST_BLOB_PREFIX=t3mp3st-runtime
T3MP3ST_LEGACY_BLOB_PREFIX=t3mp3st-runtime/v1
T3MP3ST_MAX_TOKENS=1024
T3MP3ST_READ_ONLY=false
# Enable one minimal startup inference during release verification.
T3MP3ST_RUN_SMOKE=false
# Optional nonsecret unique canary marker; leave unset outside verification.
# T3MP3ST_AUDIT_CANARY=release-verification-marker
# Model fallback is disabled unless explicitly enabled with an allowlist.
T3MP3ST_OPENAI_ALLOW_FALLBACK=false
