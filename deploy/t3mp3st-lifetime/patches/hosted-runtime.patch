+
+export function hostedJsonError(error: unknown, _req: Request, res: Response, next: NextFunction): void {
+  if (!hostedMode()) return next(error);
+  const status = (error as { status?: number })?.status;
+  if (status === 413 || (error as { type?: string })?.type === 'entity.too.large') {
