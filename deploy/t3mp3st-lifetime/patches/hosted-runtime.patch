+import { mkdir, readFile, rename, unlink, writeFile } from 'node:fs/promises';
+import { dirname } from 'node:path';
+import { randomUUID } from 'node:crypto';
+
+/** Serializes full snapshot replacements and event appends through one queue. */
+export class SerializedPersistenceQueue {
+  private tail: Promise<unknown> = Promise.resolve();
+  private lastError: unknown = null;
+
+  run<T>(operation: () => Promise<T>): Promise<T> {
+    const result = this.tail.then(operation, operation).catch(error => {
+      this.lastError = error;
+      throw error;
+    });
+    this.tail = result.then(() => undefined, () => undefined);
+    return result;
+  }
+
+  atomicWrite(path: string, contents: string): Promise<void> {
+    return this.run(() => this.retry(async () => {
+      await mkdir(dirname(path), { recursive: true });
+      const tempPath = `${path}.tmp-${process.pid}-${randomUUID()}`;
+      try {
+        await writeFile(tempPath, contents, { flag: 'wx' });
+        await rename(tempPath, path);
+      } catch (error) {
+        await unlink(tempPath).catch(() => undefined);
+        throw error;
+      }
+    }));
+  }
+
+  append(path: string, contents: string): Promise<void> {
+    return this.run(() => this.retry(async () => {
+      await mkdir(dirname(path), { recursive: true });
+      let existing = '';
+      try {
+        existing = await readFile(path, 'utf8');
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+      }
+      const tempPath = `${path}.tmp-${process.pid}-${randomUUID()}`;
+      try {
+        await writeFile(tempPath, `${existing}${contents}`, { flag: 'wx' });
+        await rename(tempPath, path);
+      } catch (error) {
+        await unlink(tempPath).catch(() => undefined);
+        throw error;
+      }
+    }));
+  }
+
+  async drain(): Promise<void> {
+    await this.tail;
+    if (this.lastError) throw this.lastError;
+  }
+
+  private async retry(operation: () => Promise<void>): Promise<void> {
+    let lastError: unknown;
+    for (let attempt = 0; attempt < 3; attempt++) {
+      try {
+        await operation();
+        return;
+      } catch (error) {
+        lastError = error;
+        if (attempt < 2) await new Promise(resolve => setTimeout(resolve, 50 * (attempt + 1)));
+      }
+    }
+    throw lastError;
+  }
+}
+
+export function unknownStateFields(state: Record<string, unknown>, knownKeys: ReadonlySet<string>): Record<string, unknown> {
+  return Object.fromEntries(Object.entries(state).filter(([key]) => !knownKeys.has(key)));
+}
+
+export function isValidHostedStateSnapshot(state: Record<string, unknown>, requiredArrays: readonly string[]): boolean {
+  if (state.schema_version !== 't3mp3st_state/v1') return false;
+  return requiredArrays.every(key => {
+    const records = state[key];
+    if (!Array.isArray(records)) return false;
+    const ids = new Set<string>();
+    for (const record of records) {
+      if (!record || typeof record !== 'object' || typeof (record as { id?: unknown }).id !== 'string') return false;
+      const id = (record as { id: string }).id.trim();
+      if (!id || ids.has(id)) return false;
+      ids.add(id);
+    }
+    return true;
+  });
+}
