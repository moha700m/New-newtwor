@@ -0,0 +1,66 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { LLMBackbone, LLMApiError } from '../llm/index.js';
+import { HOSTED_OPENAI_BASE_URL } from '../hosted-policy.js';
+
+const previousHosted = process.env.T3MP3ST_HOSTED;
+afterEach(() => {
+  vi.unstubAllGlobals();
+  if (previousHosted === undefined) delete process.env.T3MP3ST_HOSTED;
+  else process.env.T3MP3ST_HOSTED = previousHosted;
+});
+
+function backbone(): LLMBackbone {
+  return new LLMBackbone({
+    provider: 'openai', model: 'gpt-test', apiKey: 'server-key-for-tests',
+    baseUrl: HOSTED_OPENAI_BASE_URL, timeout: 30_000, fallbackChain: [],
+  });
+}
+
+describe('hosted OpenAI runtime', () => {
+  it('keeps upstream error bodies private and exposes only safe status/code/parameter metadata', async () => {
+    process.env.T3MP3ST_HOSTED = 'true';
+    vi.stubGlobal('fetch', vi.fn(async () => new Response(JSON.stringify({
+      error: { message: 'raw provider body with secret-value', code: 'unsupported_parameter', param: 'max_tokens' },
+    }), { status: 400 })));
+    const llm = backbone();
+    llm.setRetryConfig(1, 0);
+    let caught: unknown;
+    try { await llm.prompt('test'); } catch (error) { caught = error; }
+    expect(caught).toBeInstanceOf(LLMApiError);
+    expect(caught).toMatchObject({ status: 400, upstreamCode: 'unsupported_parameter', upstreamParam: 'max_tokens' });
+    expect((caught as Error).message).not.toContain('secret-value');
+  });
+
+  it('aborts a Retry-After backoff when the caller cancels instead of waiting on the provider delay', async () => {
+    process.env.T3MP3ST_HOSTED = 'true';
+    const fetch = vi.fn(async () => new Response('{}', { status: 429, headers: { 'retry-after': '999' } }));
+    vi.stubGlobal('fetch', fetch);
+    const llm = backbone();
+    const controller = new AbortController();
+    setTimeout(() => controller.abort(), 25);
+    const started = Date.now();
+    await expect(llm.prompt('test', undefined, { signal: controller.signal })).rejects.toThrow(/aborted|timed out/i);
+    expect(Date.now() - started).toBeLessThan(500);
+    expect(fetch).toHaveBeenCalledTimes(1);
+  });
+
+  it('applies the hosted 1024-token cap while leaving standalone OpenAI behavior intact', async () => {
+    const fetch = vi.fn(async (_url: string, init?: RequestInit) => {
+      const body = JSON.parse(String(init?.body)) as { max_tokens: number };
+      return new Response(JSON.stringify({ choices: [{ message: { content: String(body.max_tokens) } }] }), { status: 200 });
+    });
+    vi.stubGlobal('fetch', fetch);
+    process.env.T3MP3ST_HOSTED = 'true';
+    const hosted = backbone();
+    hosted.setRetryConfig(1, 0);
+    await hosted.prompt('test', undefined, { maxTokens: 5000 });
+    expect(JSON.parse(String(fetch.mock.calls[0]?.[1]?.body)).max_tokens).toBe(1024);
+
+    fetch.mockClear();
+    delete process.env.T3MP3ST_HOSTED;
+    const standalone = backbone();
+    standalone.setRetryConfig(1, 0);
+    await standalone.prompt('test', undefined, { maxTokens: 5000 });
+    expect(JSON.parse(String(fetch.mock.calls[0]?.[1]?.body)).max_tokens).toBe(5000);
+  });
+});
