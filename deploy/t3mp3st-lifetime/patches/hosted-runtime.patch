+}
+
+export function hostedChildEnvironment(env: NodeJS.ProcessEnv = process.env): NodeJS.ProcessEnv {
+  const safeNames = new Set(['PATH', 'TMPDIR', 'TMP', 'TEMP', 'LANG', 'LC_ALL', 'TERM', 'SYSTEMROOT', 'WINDIR', 'PATHEXT', 'COMSPEC']);
+  const result = Object.fromEntries(Object.entries(env).filter(([key, value]) => safeNames.has(key.toUpperCase()) && value !== undefined));
