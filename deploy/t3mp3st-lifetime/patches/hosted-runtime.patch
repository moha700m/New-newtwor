+    if (normalized === 'operatorcount' && (typeof child !== 'number' || !Number.isInteger(child) || child < 1 || child > 8)) return 'operatorCount must be between 1 and 8';
+    if (normalized === 'maxrounds' && (typeof child !== 'number' || !Number.isInteger(child) || child < 1 || child > 5)) return 'maxRounds must be between 1 and 5';
