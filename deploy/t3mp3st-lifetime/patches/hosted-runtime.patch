+      readOnly: persistenceFailed ? true : status.persistence.readOnly ?? null,
+      revision: status.persistence.revision ?? null,
+      lastSyncAt: status.persistence.lastSyncAt ?? null,
+      claim: status.persistence.claim ?? null,
