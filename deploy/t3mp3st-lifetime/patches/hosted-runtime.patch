@@ -0,0 +1,71 @@
+import { afterEach, describe, expect, it } from 'vitest';
+import { mkdtemp, readFile, readdir, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { isValidHostedStateSnapshot, SerializedPersistenceQueue, unknownStateFields } from '../persistence/atomic-state.js';
+
+let tempRoot = '';
+afterEach(async () => {
+  if (tempRoot) await rm(tempRoot, { recursive: true, force: true });
+  tempRoot = '';
+});
+
+describe('serialized atomic state persistence', () => {
+  it('serializes snapshot replacement with event appends and drain waits for in-flight work', async () => {
+    tempRoot = await mkdtemp(join(tmpdir(), 't3mp3st-atomic-state-'));
+    const statePath = join(tempRoot, 'state.json');
+    const eventPath = join(tempRoot, 'events.jsonl');
+    const queue = new SerializedPersistenceQueue();
+    const order: string[] = [];
+    let release!: () => void;
+    const gate = new Promise<void>(resolve => { release = resolve; });
+    const first = queue.run(async () => { order.push('first:start'); await gate; order.push('first:end'); });
+    const snapshot = queue.atomicWrite(statePath, '{"revision":2,"ledger":[1,2]}');
+    const event = queue.append(eventPath, '{"type":"updated"}\n');
+    let drained = false;
+    const drain = queue.drain().then(() => { drained = true; });
+    await new Promise(resolve => setTimeout(resolve, 10));
+    expect(drained).toBe(false);
+    release();
+    await Promise.all([first, snapshot, event, drain]);
+    expect(order).toEqual(['first:start', 'first:end']);
+    expect(JSON.parse(await readFile(statePath, 'utf8'))).toEqual({ revision: 2, ledger: [1, 2] });
+    expect(await readFile(eventPath, 'utf8')).toBe('{"type":"updated"}\n');
+    expect((await readdir(tempRoot)).some(name => name.includes('.tmp-'))).toBe(false);
+  });
+
+  it('retains unknown compatible state fields while excluding owned snapshot keys', () => {
+    const extras = unknownStateFields({
+      schema_version: 't3mp3st_state/v1',
+      evidenceLedger: [],
+      credential_policy: { retention: 'server-only' },
+      futureRuntimeMetadata: { revision: 3 },
+    }, new Set(['schema_version', 'evidenceLedger']));
+    expect(extras).toEqual({
+      credential_policy: { retention: 'server-only' },
+      futureRuntimeMetadata: { revision: 3 },
+    });
+  });
+
+  it('rejects deployed snapshots with invalid rows or duplicate ledger identifiers', () => {
+    const arrays = ['findingsLedger', 'evidenceLedger'];
+    expect(isValidHostedStateSnapshot({
+      schema_version: 't3mp3st_state/v1',
+      findingsLedger: [{ id: 'finding-1' }], evidenceLedger: [],
+    }, arrays)).toBe(true);
+    expect(isValidHostedStateSnapshot({
+      schema_version: 't3mp3st_state/v1',
+      findingsLedger: [{ id: 'finding-1' }, { id: 'finding-1' }], evidenceLedger: [],
+    }, arrays)).toBe(false);
+    expect(isValidHostedStateSnapshot({
+      schema_version: 't3mp3st_state/v1',
+      findingsLedger: [{ title: 'missing id' }], evidenceLedger: [],
+    }, arrays)).toBe(false);
+  });
+
+  it('fails closed when an unrecovered queued write error remains at drain', async () => {
+    const queue = new SerializedPersistenceQueue();
+    await expect(queue.run(async () => { throw new Error('write failed'); })).rejects.toThrow('write failed');
+    await expect(queue.drain()).rejects.toThrow('write failed');
+  });
+});
