+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { config } from '../config/index.js';
+import { buildDecompositionConfig } from '../recon/whitebox.js';
+import {
+  HOSTED_OPENAI_BASE_URL,
+  HostedRateLimiter,
+  hostedBodyPolicyViolation,
+  hostedForbiddenPath,
+  hostedSafeCommand,
+  hostedHostAllowed,
+  hostedJsonError,
+  hostedOriginAllowed,
+  hostedRequestPolicy,
+  hostedRuntimeReady,
+  publicHostedRuntimeStatus,
+  hostedChildEnvironment,
+} from '../hosted-policy.js';
+
+afterEach(() => {
+  delete process.env.T3MP3ST_HOSTED;
+  delete process.env.T3MP3ST_STATE_DIR;
+  delete process.env.VERCEL_URL;
+});
+
+describe('hosted source policy', () => {
+  it('accepts only the exact production hosts and exact HTTPS origins', () => {
+    expect(hostedHostAllowed('t3mp3st-full.vercel.app')).toBe(true);
+    expect(hostedHostAllowed('t3mp3st-full.vercel.app.evil.test')).toBe(false);
+    expect(hostedHostAllowed('evil.test')).toBe(false);
+    expect(hostedHostAllowed('localhost:3000')).toBe(true);
+    expect(hostedOriginAllowed('https://t3mp3st-full-moha700ms-projects.vercel.app')).toBe(true);
+    expect(hostedOriginAllowed('http://t3mp3st-full.vercel.app')).toBe(false);
+    expect(hostedOriginAllowed('https://t3mp3st-full.vercel.app.evil.test')).toBe(false);
+    expect(hostedOriginAllowed('null')).toBe(false);
+    process.env.VERCEL_URL = 't3mp3st-preview-123.vercel.app';
+    expect(hostedOriginAllowed('https://t3mp3st-preview-123.vercel.app')).toBe(true);
+  });
+
+  it('blocks unsupported local capabilities and caller-selected credentials or providers', () => {
+    expect(hostedForbiddenPath('/api/agents/local/dispatch')).toBe(true);
+    expect(hostedForbiddenPath('/API/CODEX/PROBE')).toBe(true);
+    expect(hostedForbiddenPath('/api/net/proxy')).toBe(true);
+    expect(hostedForbiddenPath('/api/notify/chat-id')).toBe(true);
+    expect(hostedForbiddenPath('/api/mission/start')).toBe(false);
+    expect(hostedSafeCommand('nmap', ['--version'])).toBe(true);
+    expect(hostedSafeCommand('curl', ['--config', '/tmp/secret'])).toBe(false);
+    expect(hostedSafeCommand('nmap', ['--script', 'all', 'target.example'])).toBe(false);
+    expect(hostedBodyPolicyViolation({ llm: { apiKey: 'do-not-return' } })).toContain('credentials');
+    expect(hostedBodyPolicyViolation({ openaiKey: 'do-not-return' })).toContain('credentials');
+    expect(hostedBodyPolicyViolation({ credential_policy: { storage: 'server-only' } })).toBeNull();
+    expect(hostedBodyPolicyViolation({ config: { workerMaxTokens: 512, credential_policy: 'server-only' } })).toBeNull();
+    expect(hostedBodyPolicyViolation({ config: { provider: 'local-agent' } })).toContain('OpenAI');
+    expect(hostedBodyPolicyViolation({ mission: { baseUrl: 'http://127.0.0.1:11434' } })).toContain('canonical OpenAI');
+    expect(hostedBodyPolicyViolation({ provider: 'openai', baseUrl: HOSTED_OPENAI_BASE_URL })).toBeNull();
+    expect(hostedBodyPolicyViolation({ maxTokens: 1025 })).toContain('maxTokens');
+    expect(hostedBodyPolicyViolation({ timeoutMs: 60_001 })).toContain('Timeout');
+    expect(hostedBodyPolicyViolation({ targets: ['a', 'b', 'c', 'd', 'e', 'f'] })).toContain('five targets');
+    expect(hostedBodyPolicyViolation({ operators: ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i'] })).toContain('eight operators');
+    expect(hostedBodyPolicyViolation({ systemPrompt: 'x'.repeat(2001) })).toContain('prompt size');
+  });
+
+  it('uses bounded rate buckets and redacts runtime status internals', () => {
+    const limiter = new HostedRateLimiter();
+    expect(limiter.allow('client:/api/llm/chat', 1, 100, 1_000)).toBe(true);
+    expect(limiter.allow('client:/api/llm/chat', 1, 100, 1_001)).toBe(false);
+    expect(limiter.allow('client:/api/llm/chat', 1, 100, 1_100)).toBe(true);
+    const output = publicHostedRuntimeStatus({
+      ready: true, readOnly: false,
+      runtime: { nodeVersion: 'v22.0.0', uid: 1000, release: 'release-1' },
+      lastError: { category: 'storage', at: '2026-01-01T00:00:00Z' },
+      canary: { enabled: true }, llm: { ready: true },
+      legacyDigests: { state: 'secret' },
+      persistence: { privateReadCheck: { checked: true, denied: true, status: 403, checkedAt: '2026-01-01T00:00:00Z' } },
+    } as never);
+    expect(output.lastError).toEqual({ category: 'storage', at: '2026-01-01T00:00:00Z' });
+    expect(output).not.toHaveProperty('legacyDigests');
+    expect(output).toMatchObject({ runtime: { nodeVersion: 'v22.0.0', uid: 1000, release: 'release-1' } });
+    expect(output).toMatchObject({ persistence: { privateReadCheck: { checked: true, denied: true, status: 403 } } });
+    expect(hostedChildEnvironment({ PATH: '/bin', OPENAI_API_KEY: 'secret', VERCEL_URL: 'deployment', HOME: '/root' }).OPENAI_API_KEY).toBeUndefined();
+    expect(hostedChildEnvironment({ PATH: '/bin', OPENAI_API_KEY: 'secret', VERCEL_URL: 'deployment', HOME: '/root' }).HOME).toBe('/tmp/t3mp3st-workspace');
+  });
+
+  it('expires hosted readiness when a supplied storage lease is stale', () => {
+    expect(hostedRuntimeReady({ ready: true, readOnly: false })).toBe(true);
+    expect(hostedRuntimeReady({ ready: true, readOnly: false, leaseExpiresAt: '2000-01-01T00:00:00.000Z' })).toBe(false);
+    expect(hostedRuntimeReady({ ready: true, readOnly: false, leaseExpiresAt: 'not-a-date' })).toBe(false);
+  });
+
+  it('rejects a cross-site request before any body or route work', () => {
+    process.env.T3MP3ST_HOSTED = 'true';
+    const req = {
+      headers: { host: 't3mp3st-full.vercel.app' },
+      socket: { remoteAddress: '198.51.100.1' },
+      path: '/api/mission/start', method: 'POST',
+      get: (name: string) => ({ origin: 'https://attacker.test', 'sec-fetch-site': 'cross-site' } as Record<string, string>)[name],
+    } as never;
+    const res = { status: vi.fn().mockReturnThis(), json: vi.fn() } as never;
+    const next = vi.fn();
+    hostedRequestPolicy(req, res, next);
+    expect((res as { status: ReturnType<typeof vi.fn> }).status).toHaveBeenCalledWith(403);
+    expect((res as { json: ReturnType<typeof vi.fn> }).json).toHaveBeenCalledWith({ error: 'Request origin rejected' });
+    expect(next).not.toHaveBeenCalled();
+  });
+
+  it('forces server config to OpenAI and rejects alternate providers in hosted mode', () => {
+    process.env.T3MP3ST_HOSTED = 'true';
+    expect(config.getLLMConfig().provider).toBe('openai');
+    expect(() => config.getLLMConfig('local')).toThrow('only the OpenAI provider');
+    expect(() => config.getLLMConfig('local-agent')).toThrow('only the OpenAI provider');
+  });
+
+  it('builds hosted white-box worker and orchestrator configs on the canonical OpenAI model', () => {
+    process.env.T3MP3ST_HOSTED = 'true';
+    const decomposition = buildDecompositionConfig();
+    expect(decomposition.orchestratorModel.provider).toBe('openai');
+    expect(decomposition.workerModel.provider).toBe('openai');
+    expect(decomposition.orchestratorModel.baseUrl).toBe(HOSTED_OPENAI_BASE_URL);
+    expect(decomposition.workerModel.baseUrl).toBe(HOSTED_OPENAI_BASE_URL);
+    expect(decomposition.orchestratorModel.fallbackChain).toEqual([]);
+    expect(decomposition.workerModel.fallbackChain).toEqual([]);
+    expect(decomposition.orchestratorModel.timeout).toBeLessThanOrEqual(30_000);
+    expect(decomposition.maxRounds).toBe(5);
+  });
+
+  it('normalizes malformed and oversized JSON errors in hosted mode', () => {
+    process.env.T3MP3ST_HOSTED = 'true';
+    const res = { status: vi.fn().mockReturnThis(), json: vi.fn() } as never;
+    hostedJsonError({ type: 'entity.parse.failed', status: 400 }, {} as never, res, vi.fn());
+    expect((res as { status: ReturnType<typeof vi.fn> }).status).toHaveBeenCalledWith(400);
+    expect((res as { json: ReturnType<typeof vi.fn> }).json).toHaveBeenCalledWith({ error: 'Malformed JSON request body' });
+    const largeRes = { status: vi.fn().mockReturnThis(), json: vi.fn() } as never;
+    hostedJsonError({ type: 'entity.too.large', status: 413 }, {} as never, largeRes, vi.fn());
+    expect((largeRes as { status: ReturnType<typeof vi.fn> }).status).toHaveBeenCalledWith(413);
+  });
+});
