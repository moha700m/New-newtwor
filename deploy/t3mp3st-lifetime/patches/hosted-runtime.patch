+import { afterEach, describe, expect, it, vi } from 'vitest';
+import type { LLMConfig, LLMMessage, LLMToolDefinition } from '../types/index.js';
+import { LLMBackbone } from '../llm/index.js';
+import { HOSTED_OPENAI_BASE_URL } from '../hosted-policy.js';
+
+const previousHosted = process.env.T3MP3ST_HOSTED;
+const tool: LLMToolDefinition = {
+  name: 'http_probe',
+  description: 'Probe an in-scope URL',
+  parameters: {
+    type: 'object',
+    properties: { url: { type: 'string' } },
+    required: ['url'],
+  },
+};
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  if (previousHosted === undefined) delete process.env.T3MP3ST_HOSTED;
+  else process.env.T3MP3ST_HOSTED = previousHosted;
+});
+
+function backbone(overrides: Partial<LLMConfig> = {}): LLMBackbone {
+  const llm = new LLMBackbone({
+    provider: 'openai', model: 'gpt-6.1-sol', apiKey: 'test-key',
+    baseUrl: HOSTED_OPENAI_BASE_URL, timeout: 30_000, fallbackChain: [], ...overrides,
+  });
+  llm.setRetryConfig(1, 0);
+  return llm;
+}
+
+function response(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), { status, headers: { 'content-type': 'application/json' } });
+}
+
+function assistantMessage(messages: LLMMessage[]): LLMMessage & { role: 'assistant' } {
+  const message = messages[1];
+  if (!message || message.role !== 'assistant') throw new Error('Test history is missing its assistant turn');
+  return message as LLMMessage & { role: 'assistant' };
+}
+
+function toolResponse({
+  callId = 'call_native_1',
+  outputId = 'fc_output_1',
+  encryptedContent = 'encrypted-reasoning-1',
+  phase = 'commentary',
+  assistantText = 'Inspect the scoped target.',
+  argumentsText = '{"url":"https://lab.example"}',
+}: {
+  callId?: string;
+  outputId?: string;
+  encryptedContent?: string;
+  phase?: string;
+  assistantText?: string;
+  argumentsText?: string;
+} = {}): unknown {
+  return {
+    id: `resp_${callId}`,
+    status: 'completed',
+    model: 'gpt-6.1-sol',
+    output: [
+      { id: `rs_${callId}`, type: 'reasoning', encrypted_content: encryptedContent },
+      {
+        id: `msg_${callId}`, type: 'message', role: 'assistant', phase, status: 'completed',
+        content: [{ type: 'output_text', text: assistantText, annotations: [] }],
+      },
+      {
+        id: outputId, type: 'function_call', status: 'completed', call_id: callId,
+        name: 'http_probe', arguments: argumentsText,
+      },
+    ],
+    usage: { input_tokens: 23, output_tokens: 6, total_tokens: 29 },
+  };
+}
+
+describe('OpenAI GPT-6 Responses transport', () => {
+  it('uses Responses only for canonical OpenAI GPT-6 models and sends the supported body', async () => {
+    process.env.T3MP3ST_HOSTED = 'true';
+    const fetch = vi.fn(async (_url: string, _init?: RequestInit) => response({
+      id: 'resp_text', status: 'completed', model: 'gpt-6.1-sol',
+      output: [{ type: 'message', role: 'assistant', status: 'completed', phase: 'final_answer', content: [{ type: 'output_text', text: 'ready' }] }],
+    }));
+    vi.stubGlobal('fetch', fetch);
+
+    await backbone().prompt('test', undefined, { maxTokens: 9000, temperature: 0.4, topP: 0.2, stopSequences: ['STOP'] });
+    const [url, init] = fetch.mock.calls[0] ?? [];
+    const body = JSON.parse(String(init?.body)) as Record<string, unknown>;
+    expect(url).toBe(`${HOSTED_OPENAI_BASE_URL}/responses`);
+    expect(body).toMatchObject({
+      model: 'gpt-6.1-sol', store: false, max_output_tokens: 1024,
+      reasoning: { effort: 'low' }, include: ['reasoning.encrypted_content'], input: [{ role: 'user', content: 'test' }],
+    });
+    expect(body).not.toHaveProperty('temperature');
+    expect(body).not.toHaveProperty('top_p');
+    expect(body).not.toHaveProperty('stop');
+    expect(body).not.toHaveProperty('max_tokens');
+
+    fetch.mockClear();
+    delete process.env.T3MP3ST_HOSTED;
+    await backbone().prompt('test', undefined, { maxTokens: 2048 });
+    expect(fetch.mock.calls[0]?.[0]).toBe(`${HOSTED_OPENAI_BASE_URL}/responses`);
+    expect(JSON.parse(String(fetch.mock.calls[0]?.[1]?.body)).max_output_tokens).toBe(2048);
+  });
