+import type { NextFunction, Request, Response } from 'express';
+import { readFile } from 'node:fs/promises';
+import { join } from 'node:path';
+
+export const HOSTED_OPENAI_BASE_URL = 'https://api.openai.com/v1';
+const STATIC_HOSTS = new Set([
+  't3mp3st-full.vercel.app',
+  't3mp3st-full-moha700ms-projects.vercel.app',
+]);
+const SAFE_LOCAL_HOSTS = new Set(['127.0.0.1', 'localhost']);
+
+export function hostedMode(env: NodeJS.ProcessEnv = process.env): boolean {
+  return env.T3MP3ST_HOSTED === 'true';
+}
+
+function normalizeHost(host: string): string {
+  return host.trim().toLowerCase().replace(/:\d+$/, '').replace(/^\[|\]$/g, '');
+}
+
+export function hostedAllowedHosts(env: NodeJS.ProcessEnv = process.env): Set<string> {
+  const hosts = new Set(STATIC_HOSTS);
+  const deploymentHost = env.VERCEL_URL?.trim();
+  if (deploymentHost) hosts.add(normalizeHost(deploymentHost.replace(/^https?:\/\//i, '').split('/')[0]));
+  return hosts;
+}
+
+export function hostedHostAllowed(hostHeader: string | undefined, env: NodeJS.ProcessEnv = process.env): boolean {
+  if (!hostHeader) return false;
+  const host = normalizeHost(hostHeader);
+  return hostedAllowedHosts(env).has(host) || SAFE_LOCAL_HOSTS.has(host);
+}
+
+export function hostedOriginAllowed(origin: string | undefined, env: NodeJS.ProcessEnv = process.env): boolean {
+  if (!origin || origin === 'null') return false;
+  try {
+    const parsed = new URL(origin);
+    if (parsed.username || parsed.password || parsed.pathname !== '/' || parsed.search || parsed.hash) return false;
+    const host = parsed.hostname.toLowerCase().replace(/^\[|\]$/g, '');
+    if (SAFE_LOCAL_HOSTS.has(host)) return parsed.protocol === 'http:' || parsed.protocol === 'https:';
+    return parsed.protocol === 'https:' && hostedAllowedHosts(env).has(host);
+  } catch {
+    return false;
+  }
+}
+
+export function hostedForbiddenPath(path: string): boolean {
+  const normalizedPath = path.toLowerCase();
+  return [
+    /^\/api\/net\/proxy(?:\/|$)/,
+    /^\/api\/net\/ip(?:\/|$)/,
+    /^\/api\/llm\/local(?:\/|$)/,
+    /^\/api\/codex(?:\/|$)/,
+    /^\/api\/agents\/local(?:\/|$)/,
+    /^\/api\/bounty\/credentials(?:\/|$)/,
+    /^\/api\/notify\/chat-id(?:\/|$)/,
+    /^\/api\/config(?:\/|$)/,
+    /^\/api\/settings(?:\/|$)/,
+  ].some(pattern => pattern.test(normalizedPath));
+}
+
+export function hostedSafeCommand(bin: string, args: string[]): boolean {
+  const versionOnly = new Set(['nmap', 'curl', 'git', 'jq', 'python3', 'node', 'trivy', 'yara', 'exiftool']);
+  return versionOnly.has(bin) && args.length === 1 && ['--version', '-version', '-V'].includes(args[0]);
+}
+
+export function hostedBodyPolicyViolation(value: unknown): string | null {
+  const pending: Array<{ value: unknown; depth: number }> = [{ value, depth: 0 }];
+  let inspected = 0;
+  while (pending.length) {
+    const current = pending.pop()!;
+    if (!current.value || typeof current.value !== 'object') continue;
+    if (current.depth > 32) return 'Hosted request body nesting exceeds the policy limit';
+    const entries = Array.isArray(current.value)
+      ? current.value.map((child, index) => [String(index), child] as const)
+      : Object.entries(current.value as Record<string, unknown>);
+    inspected += entries.length;
+    if (inspected > 10_000) return 'Hosted request body contains too many fields';
+    for (const [key, child] of entries) {
+      const normalized = key.toLowerCase().replace(/[-_]/g, '');
+    const isClientCredential = (
+      normalized === 'authorization' || normalized === 'apikey' || normalized.endsWith('apikey')
+      || normalized === 'openaikey' || normalized === 'key' || normalized === 'accesskey'
+      || normalized === 'secret' || normalized.endsWith('secretkey') || normalized.endsWith('secrettoken')
+      || ['token', 'accesstoken', 'refreshtoken', 'authtoken', 'bearertoken'].includes(normalized)
+      || normalized === 'password' || normalized.endsWith('password')
