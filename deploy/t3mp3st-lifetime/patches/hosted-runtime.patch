+        }
+        throw error;
+      }
+      if (!toolCalls?.length) throw new OpenAIResponsesPayloadError('GPT-6 Responses returned an empty function-call group');
+
+      const items = replayItems(data.output);
+      const replayedCalls = items.filter(item => item.type === 'function_call');
+      if (replayedCalls.length !== toolCalls.length) throw new OpenAIResponsesPayloadError('GPT-6 Responses function-call group could not be replayed');
+      const key = callKey(toolCalls.map(call => call.id));
+      if (this.entries.has(key)) throw new OpenAIResponsesPayloadError('GPT-6 Responses reused a native call ID');
+      const group: ContinuationGroup = {
+        key,
+        conversationKey: lease.conversationKey,
+        assistantContent: content,
+        calls: toolCalls.map(call => ({ id: call.id, name: call.name, arguments: structuredClone(call.arguments) })),
+        items,
+        bytes: 0,
+      };
+      group.bytes = new TextEncoder().encode(JSON.stringify(group)).byteLength;
+      if (group.bytes > MAX_CONTINUATION_BYTES) throw new OpenAIResponsesPayloadError('GPT-6 Responses continuation group exceeds the private cache limit');
+      this.makeRoom(group.bytes, lease.pinnedKeys);
+      this.entries.set(key, group);
+      this.byteSize += group.bytes;
+    }
+
+    const refusalFinish = refusal || rawCalls.some(call => call.type === 'refusal');
+    const result: LLMResponse = {
+      content,
+      model: typeof data.model === 'string' ? data.model : model,
+      finishReason: refusalFinish ? 'refusal' : toolCalls?.length ? 'tool_calls' : 'stop',
+      toolCalls,
+      usage: safeUsage(data.usage),
+    };
+    return result;
+  }
+
+  private matchesCalls(cached: CachedCall[], supplied: LLMToolCall[]): boolean {
+    if (cached.length !== supplied.length) return false;
+    const byId = new Map(cached.map(call => [call.id, call]));
+    return supplied.every(call => {
+      const previous = byId.get(call.id);
+      return previous !== undefined && previous.name === call.name
+        && stableJson(previous.arguments) === stableJson(call.arguments);
+    });
+  }
+
+  private syntheticBootstrapItems(message: LLMMessage, tools?: readonly LLMToolDefinition[]): ResponsesInputItem[] | undefined {
+    const calls = message.toolCalls;
+    if (message.content !== LOCAL_AGENT_BOOTSTRAP_TEXT || calls?.length !== 1) return undefined;
+    const call = calls[0];
+    if (!call) return undefined;
+    if (!/^local-agent-bootstrap-\d+$/.test(call.id) || !tools?.length) return undefined;
+    try {
+      const validated = enforceToolCallBoundary(JSON.stringify({ tool_calls: [call] }), tools).calls;
+      if (!validated?.length) return undefined;
+      return [
+        {
+          type: 'message',
+          role: 'assistant',
+          status: 'completed',
+          content: [{ type: 'output_text', text: message.content }],
+        },
+        {
+          type: 'function_call',
+          status: 'completed',
+          call_id: call.id,
+          name: call.name,
+          arguments: JSON.stringify(call.arguments),
+        },
+      ];
+    } catch {
+      return undefined;
+    }
+  }
+
+  private makeRoom(bytes: number, currentRequestKeys: readonly string[]): void {
+    const protectedKeys = new Set([...currentRequestKeys, ...this.activePins.keys()]);
+    while (this.entries.size + 1 > MAX_CONTINUATION_GROUPS || this.byteSize + bytes > MAX_CONTINUATION_BYTES) {
+      const candidate = [...this.entries.entries()].find(([key]) => !protectedKeys.has(key) && !this.activePins.has(key));
+      if (!candidate) throw new OpenAIResponsesPayloadError('GPT-6 Responses continuation cache cannot retain the required history');
+      const [key, removed] = candidate;
+      this.entries.delete(key);
+      this.byteSize -= removed.bytes;
+    }
+  }
+}
