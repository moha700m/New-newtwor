NODE_ENV=development
PORT=8787
HOST=0.0.0.0

MCP_API_KEY=change-me
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8787

SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=replace-with-random-secret
ENABLE_DDG_FALLBACK=true

MAX_BROWSER_SESSIONS=5
BROWSER_SESSION_TTL=600
BROWSER_IDLE_TTL=300
BROWSER_MEMORY_MB=256
PAGE_TIMEOUT_MS=30000

MAX_HTML_BYTES=10000000
MAX_TEXT_CHARS=100000
MAX_DOWNLOAD_BYTES=25000000
MAX_REDIRECTS=5

SEARCH_CACHE_TTL=300
PAGE_CACHE_TTL=300
CACHE_MAX_ENTRIES=256

USER_AGENT=OpenWebMCP/1.0
REQUEST_DELAY_MS=100
PER_DOMAIN_CONCURRENCY=2
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
GLOBAL_CONCURRENCY=16
