{
  "name": "open-web-mcp",
  "version": "1.0.0",
  "description": "Production web research and browser automation MCP server for ChatGPT and other MCP hosts.",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/fastify": "^2.0.1",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.5",
    "ipaddr.js": "^2.2.0",
    "linkedom": "^0.18.12",
    "pino": "^9.9.0",
    "playwright": "1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^5.0.3"
  }
}
